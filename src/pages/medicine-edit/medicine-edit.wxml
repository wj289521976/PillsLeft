<view class="container">
  <form bindsubmit="onSubmit">
    <view class="form-group">
      <view class="form-label">药品名称</view>
      <input
        class="form-input"
        placeholder="如：阿莫西林胶囊"
        maxlength="30"
        value="{{form.name}}"
        bindinput="onInput"
        data-field="name"
      />
    </view>

    <view class="form-group">
      <view class="form-label">服用时间（备注）</view>
      <input
        class="form-input"
        placeholder="如：早饭后 / 睡前"
        maxlength="50"
        value="{{form.usageTime}}"
        bindinput="onInput"
        data-field="usageTime"
      />
    </view>

    <view class="form-group">
      <view class="form-label">规格（每盒粒数）</view>
      <input
        class="form-input"
        type="number"
        placeholder="正整数"
        value="{{form.specPerBox}}"
        bindinput="onInput"
        data-field="specPerBox"
      />
    </view>

    <view class="form-group">
      <view class="form-label">每日用量（粒）</view>
      <input
        class="form-input"
        type="digit"
        placeholder="支持小数，如0.5"
        value="{{form.dailyDose}}"
        disabled="{{doseAuto}}"
        bindinput="onInput"
        data-field="dailyDose"
      />
      <view wx:if="{{doseAuto}}" class="form-hint">服药时间可识别，每日用量按各时段剂量之和自动计算</view>
      <view wx:else class="form-hint">服药时间无法识别时，请手动填写每日总量</view>
    </view>

    <view class="form-group">
      <view class="form-label">上次补货日期</view>
      <picker
        mode="date"
        value="{{form.lastRestockDate}}"
        start="2020-01-01"
        end="{{today}}"
        bindchange="onDateChange"
      >
        <view class="form-picker">{{form.lastRestockDate}}</view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">补货时库存（粒）</view>
      <input
        class="form-input"
        type="number"
        placeholder="补货时的总粒数"
        value="{{form.lastRestockStock}}"
        bindinput="onInput"
        data-field="lastRestockStock"
      />
    </view>

    <button class="btn-primary" form-type="submit" style="margin-top: 32px;">保存</button>
  </form>
</view>