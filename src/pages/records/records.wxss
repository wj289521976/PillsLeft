.range-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 12px;
}
.range-tab {
  flex: 1;
  text-align: center;
  padding: 10px;
  font-size: 14px;
  color: #666;
}
.range-tab.active {
  background: #2F5496;
  color: #FFFFFF;
  font-weight: 600;
}

.summary-text {
  font-size: 13px;
  color: #999;
  margin-bottom: 4px;
}

.summary-sub {
  font-size: 11px;
  color: #BBB;
  margin-bottom: 12px;
}

.record-card {
  padding: 12px 16px;
}
.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.record-name {
  font-size: 15px;
  font-weight: 500;
}
.record-qty {
  font-size: 15px;
  font-weight: 700;
  color: #2F5496;
}
.record-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 6px;
  font-size: 12px;
  color: #999;
}

/* ---- 段②：用药记录（S4）---- */
.med-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 24px 0 8px;
}
.med-section-title {
  font-size: 16px;
  font-weight: 700;
  color: #333;
}
.med-section-hint {
  font-size: 12px;
  color: #999;
}

.export-bar {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}
.export-btn {
  flex: 1;
}

.med-group-label {
  font-size: 13px;
  font-weight: 600;
  color: #666;
  margin: 12px 0 8px;
}
.med-card {
  padding: 12px 16px;
  margin-bottom: 8px;
}
.med-card-stopped {
  border-left: 4px solid #FA8C16;
}
.med-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.med-name-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
}
.med-name {
  font-size: 15px;
  font-weight: 500;
}
.med-reason {
  font-size: 12px;
  color: #FA8C16;
}
.med-range {
  font-size: 12px;
  color: #999;
}
.med-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 8px;
}
.med-resume-btn {
  color: #52C41A;
  border-color: #52C41A;
}
.med-none {
  font-size: 13px;
  color: #999;
  padding: 4px 0 12px;
}
/* 按药折叠分组（2026-11-12 负责人反馈改造） */
.med-group-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.med-group-name {
  font-size: 15px;
  color: #333;
  font-weight: 500;
}
.med-group-sum {
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.med-group-days {
  font-size: 11px;
  color: #999;
}
.med-group-total {
  font-size: 18px;
  color: #2F5496;
  font-weight: 600;
}
.med-group-body {
  margin-top: 8px;
  padding-top: 4px;
  border-top: 1px dashed #E8E8E8;
}
.med-day-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 7px 0;
}
.med-day-date {
  font-size: 13px;
  color: #666;
}
.med-day-today {
  font-size: 10px;
  color: #FA8C16;
  margin-left: 6px;
}
.med-day-qty {
  font-size: 14px;
  color: #333;
}

/* 自选导出时间面板（2026-11-12 负责人批准） */
.custom-export-panel {
  border-left: 4px solid #2F5496;
}
.custom-range-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 0 4px;
}
.custom-date-box {
  display: flex;
  flex-direction: column;
  background: #F5F7FA;
  border-radius: 8px;
  padding: 8px 14px;
  min-width: 120px;
}
.custom-date-label {
  font-size: 11px;
  color: #999;
}
.custom-date-value {
  font-size: 15px;
  color: #2F5496;
  font-weight: 500;
}
.custom-range-sep {
  font-size: 13px;
  color: #999;
}
.custom-export-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 12px;
}
